{
    "name": "xfix/xfix-pay",
    "description": "Unified PHP SDK for XfixPay - M-Pesa, PayPal, Banks, XfixPay",
    "keywords": ["xfix", "xfixpay", "mpesa", "paypal", "banks", "xfixpay"],
    "type": "library", 
    "license": "MIT",
    "version": "1.2.1",
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Xfix\\XfixPay\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
